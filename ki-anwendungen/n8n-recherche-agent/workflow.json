      "typeVersion": 1.2,
      "position": [
        1408,
        160
      ],
      "id": "deb866f1-a0ad-49fa-878a-3d8018448ad5",
      "name": "Bestätigungsnachricht versenden"
    },
    {
      "parameters": {
        "pageId": {
          "__rl": true,
          "value": "https://www.notion.so/DEINE-NOTION-SEITE",
          "mode": "url"
        },
        "title": "={{ $json.title }}",
        "options": {}
      },
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [
        1008,
        160
      ],
      "id": "81abc743-1b27-4b94-be1a-9f58022d37be",
      "name": "Unterseite erstellen"
    },
    {
      "parameters": {
        "jsCode": "// Eingabetext holen (z.B. vom vorherigen Node im Feld \"text\")\nconst input = $input.first().json.output.content;\n\n// Text nach Zeilen splitten\nconst lines = input.split('\\n');\n\n// Ergebnis-Array für Notion-Blöcke\nlet blocks = [];\n\nfor (let l of lines) {\n  // Heading 2: Zeile beginnt mit \"## \" (ohne weitere # davor)\n  if (/^## (?!#)/.test(l)) {\n    blocks.push({\n      object: \"block\",\n      type: \"heading_2\",\n      heading_2: {\n        rich_text: [\n          {\n            type: \"text\",\n            text: { content: l.replace(/^## /, \"\") }\n          }\n        ]\n      }\n    });\n  } \n  // Normale Paragraphen (nicht-leere Zeile, kein Heading)\n  else if (l.trim().length > 0) {\n    blocks.push({\n      object: \"block\",\n      type: \"paragraph\",\n      paragraph: {\n        rich_text: [\n          {\n            type: \"text\",\n            text: { content: l }\n          }\n        ]\n      }\n    });\n  }\n}\n\nreturn [{ json: {title: $input.first().json.output.title, notion_blocks: blocks } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
        160
      ],
      "id": "aa7c52b5-1a9f-425d-8c76-984c26450387",
      "name": "Code"
    },
    {
